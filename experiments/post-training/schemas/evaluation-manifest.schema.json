{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://margin.local/schemas/post-training/evaluation-manifest-v1.json",
  "title": "Margin post-training evaluation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "experimentId",
    "createdAt",
    "datasetHash",
    "splitHash",
    "promptSetHash",
    "rulesSnapshotHash",
    "modelRevision",
    "tokenizerRevision",
    "conditions",
    "seeds",
    "generation",
    "manifestHash"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "experimentId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "datasetHash": { "type": "string", "minLength": 1 },
    "splitHash": { "type": "string", "minLength": 1 },
    "promptSetHash": { "type": "string", "minLength": 1 },
    "rulesSnapshotHash": { "type": "string", "minLength": 1 },
    "modelRevision": { "type": "string", "minLength": 1 },
    "tokenizerRevision": { "type": "string", "minLength": 1 },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["A", "B", "C", "D", "E", "F"] }
    },
    "seeds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer" }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temperature", "topP", "topK", "maxNewTokens"],
      "properties": {
        "temperature": { "type": "number" },
        "topP": { "type": "number" },
        "topK": { "type": "integer" },
        "maxNewTokens": { "type": "integer", "minimum": 1 }
      }
    },
    "manifestHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
